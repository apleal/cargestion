# Copia este fichero a .env y rellena los valores. NUNCA subas .env al repositorio.

# Clave secreta de Django. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambia-esto

# En local: DEBUG=True. En el servidor (EasyPanel): DEBUG=False
DEBUG=True

# Dominios permitidos, separados por coma
ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes de confianza para CSRF (en producción, tu dominio con https://)
CSRF_TRUSTED_ORIGINS=

# Base de datos. Si se deja vacío, en local usa SQLite (db.sqlite3).
# En EasyPanel, la cadena del servicio PostgreSQL, p. ej.:
#   postgres://usuario:password@host:5432/cargestion
DATABASE_URL=

# Carpeta de adjuntos (en EasyPanel, un volumen persistente)
# MEDIA_ROOT=/app/media

# Nivel de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
